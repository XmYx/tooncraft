<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.storyteller.tooncraft</id>
  <name>ToonCraft</name>
  <summary>Hand-drawn, frame-by-frame animation</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <launchable type="desktop-id">ai.storyteller.tooncraft.desktop</launchable>
  <description>
    <p>Draw with pressure-sensitive brushes on a GPU canvas, time drawings on an exposure sheet,
    flip with onion skin and a light table, colour with a gap-closing paint bucket and export PNG
    sequences and GIFs.</p>
  </description>
  <url type="homepage">https://github.com/storytold/tooncraft</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
