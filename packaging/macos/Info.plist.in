<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>ToonCraft</string>
  <key>CFBundleName</key>
  <string>ToonCraft</string>
  <key>CFBundleExecutable</key>
  <string>ToonCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.tooncraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>ToonCraftVersion</key>
  <string>@VERSION@</string>
  <key>ToonCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>ToonCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the ToonCraft authors. MIT OR Apache-2.0.</string>

  <!-- The documents ToonCraft opens, so Finder's Open With can offer it. The same set as the
       Windows installer (tooncraft.wxs) and the Linux desktop file. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>ToonCraft Shot</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>ToonCraft</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.tooncraft.shot</string>
      </array>
    </dict>
  </array>

  <!-- ToonCraft's own format: a zip of a JSON manifest plus drawings. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.tooncraft.shot</string>
      <key>UTTypeDescription</key>
      <string>ToonCraft Shot</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>ToonCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>toon</string></array>
        <key>public.mime-type</key>
        <array><string>application/vnd.storyteller.tooncraft</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
